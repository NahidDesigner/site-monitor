# ---- Dashboard (required) ---------------------------------------------------
# Without this the app refuses to start: an unprotected dashboard can edit the
# site list and trigger runs. Use a long random string, not a memorable one --
# this is on the public internet. Failed logins cost a fixed delay and lock the
# client out after 10 tries in 15 minutes, but a weak password is still weak.
DASHBOARD_PASSWORD=

# Optional. Signs session cookies. If unset, a key is derived from the password,
# which means changing the password signs everyone out — usually what you want.
SESSION_SECRET=
# How long a sign-in lasts. Default 720 (30 days).
SESSION_HOURS=720

# ---- Storage ----------------------------------------------------------------
# Sites, schedules, settings and history all live here. Put it on a volume.
DATABASE_PATH=/data/site-monitor.db

# Optional. Only used to seed the database the first time it is empty;
# after that the dashboard is the source of truth.
SITES_FILE=/app/sites.yaml

# ---- MCP (optional) ---------------------------------------------------------
# Set this to expose an MCP server at /mcp so Claude can operate the monitor:
# read reports, ask for data, start checks and PageSpeed tests, manage sites and
# schedules. Left empty, the endpoint is not mounted at all.
#
# Deliberately separate from DASHBOARD_PASSWORD: this credential is handed to an
# AI client, so it should be revocable without locking you out of the dashboard.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# Optional. Hosts the MCP endpoint answers to, comma separated. Left empty (or
# "*") the host check is off, which is right behind a reverse proxy: the
# endpoint is public and the bearer check runs first, so the DNS-rebinding
# protection this replaces — which exists to guard *local* servers — has nothing
# to add. Set it to your domain if you want the check anyway.
MCP_ALLOWED_HOSTS=

# ---- Schedules --------------------------------------------------------------
# Schedules are entered in the dashboard and interpreted in this timezone.
TIMEZONE=UTC

# ---- Everything below can also be set in the dashboard ----------------------
# Values saved in the dashboard override these without a redeploy.

# Telegram — alerts are sent only when something is broken.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PageSpeed Insights. Optional, but Google rate-limits hard without a key.
PAGESPEED_API_KEY=

# Crawl limits. A full check is roughly 15 requests per page.
SITE_CONCURRENCY=2
PAGE_CONCURRENCY=6
ASSET_CONCURRENCY=6
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RETRY_BACKOFF=1.0
MAX_PAGES_PER_SITE=0
USER_AGENT=

LOG_LEVEL=INFO
