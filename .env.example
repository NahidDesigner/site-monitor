# ---- Dashboard (required) ---------------------------------------------------
# Without this the app refuses to start: an unprotected dashboard can edit the
# site list and trigger runs.
DASHBOARD_PASSWORD=

# Optional. Signs session cookies. If unset, a key is derived from the password,
# which means changing the password signs everyone out — usually what you want.
SESSION_SECRET=
# How long a sign-in lasts. Default 720 (30 days).
SESSION_HOURS=720

# ---- Storage ----------------------------------------------------------------
# Sites, schedules, settings and history all live here. Put it on a volume.
DATABASE_PATH=/data/site-monitor.db

# Optional. Only used to seed the database the first time it is empty;
# after that the dashboard is the source of truth.
SITES_FILE=/app/sites.yaml

# ---- Schedules --------------------------------------------------------------
# Schedules are entered in the dashboard and interpreted in this timezone.
TIMEZONE=UTC

# ---- Everything below can also be set in the dashboard ----------------------
# Values saved in the dashboard override these without a redeploy.

# Telegram — alerts are sent only when something is broken.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PageSpeed Insights. Optional, but Google rate-limits hard without a key.
PAGESPEED_API_KEY=

# Crawl limits. A full check is roughly 15 requests per page.
SITE_CONCURRENCY=2
PAGE_CONCURRENCY=6
ASSET_CONCURRENCY=6
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RETRY_BACKOFF=1.0
MAX_PAGES_PER_SITE=0
USER_AGENT=

LOG_LEVEL=INFO
