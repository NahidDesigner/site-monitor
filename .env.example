# ---- Telegram ---------------------------------------------------------------
# Create a bot with @BotFather, then get the chat id from @userinfobot
# (or the group's id, which starts with -100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Paths ------------------------------------------------------------------
SITES_FILE=sites.yaml
# Put this on a Coolify persistent volume so history survives redeploys.
DATABASE_PATH=data/site-monitor.db

# ---- Concurrency ------------------------------------------------------------
# Sites checked in parallel.
SITE_CONCURRENCY=3
# Pages checked in parallel, per site.
PAGE_CONCURRENCY=8
# Stylesheet HEAD requests in parallel, per page.
ASSET_CONCURRENCY=12

# ---- HTTP -------------------------------------------------------------------
REQUEST_TIMEOUT=20
MAX_RETRIES=3
# Seconds; doubles each attempt, with jitter.
RETRY_BACKOFF=1.0
# Defaults to a desktop Chrome UA. Some stacks vary their HTML by User-Agent,
# so this should look like a real browser.
USER_AGENT=

# ---- Limits -----------------------------------------------------------------
# 0 = check every page in the sitemap.
MAX_PAGES_PER_SITE=0

# ---- Misc -------------------------------------------------------------------
LOG_LEVEL=INFO
# true = never send Telegram messages, just print them.
DRY_RUN=false
